tformName":4385,"userName":15,"url":15,"icon":4383,"oldIcon":4384},{"platformName":4389,"userName":15,"url":15,"icon":4387,"oldIcon":4388},{"platformName":4393,"userName":15,"url":15,"icon":4391,"oldIcon":4392},{"platformName":4397,"userName":15,"url":15,"icon":4395,"oldIcon":4396},{"platformName":4114,"userName":15,"url":15,"icon":4399,"oldIcon":4400},{"platformName":4404,"userName":15,"url":15,"icon":4402,"oldIcon":4403},{"id":9388,"title":9389,"firstName":9390,"lastName":9391,"image":9392,"sport":9396,"positionShort":-1,"call_to_action":-1,"bio":9397,"twitter":21,"images":15,"displayFields":9398,"latestBioId":9388,"email":9399,"phone":21,"url":15,"staffId":503,"socialMediaR":9400,"custom1":21,"custom2":21,"custom3":21,"custom4":21},1072,"Executive Assistant To Head Coach","Debbie","Schram",{"altText":9393,"url":9394,"absoluteUrl":9395,"creditName":15,"mediaCaption":15,"title":9393},"2019 Debbie Schram Head Shot","\u002Fimages\u002F2019\u002F2\u002F14\u002FDebbie_Schram_Cal_FBC_C_20180621_094047_ADS.JPG","https:\u002F\u002Fcalbears.com\u002Fimages\u002F2019\u002F2\u002F14\u002FDebbie_Schram_Cal_FBC_C_20180621_094047_ADS.JPG",{"id":210,"title":115,"shortDisplay":115,"shortName":209,"abbrev":206,"facebookPage":-1,"globalSportGender":171,"globalSportId":208,"globalSportShortName":-1,"globalSportNameSlug":209,"instagramName":-1,"nonSport":-1,"pinterestName":-1,"ticketsLink":15,"twitterName":-1,"youtubeName":-1,"rosterId":15,"scheduleId":15,"displayOpponentHistory":-1},"Debbie Schram, who has worked in the athletic department at Cal since 1985, is in the third season of her second stint with the Cal football program in 2019, currently serving as the executive assistant to head coach Justin Wilcox.\u003Cbr \u002F>\r\n\u003Cbr \u002F>\r\nPrior to her return to the football program, Schram worked in risk management and as an access coordinator at Cal from 2014-17. Her duties included serving as the facilities department lead for Communications Center and Dispatch by managing the Cal Athletics Facilities Work Order System.\u003Cbr \u002F>\r\n\u003Cbr \u002F>\r\nFrom 2010-14, Schram worked with the Leadership Team at Cal, serving as the executive assistant to the Chief Operating Officer and the Senior Associate Athletic Director of Student Services. She also served as the department liaison on scheduling for all special events in all intercollegiate athletic venues.\u003Cbr \u002F>\r\n\u003Cbr \u002F>\r\nHer first stint working with the Cal football program was from 1997-10 as an executive assistant to the head coach, the department liaison with the Cal Bearants organization and she assisted the recruiting coordinator with all recruiting activities including game day recruiting, official visits and football camps.\u003Cbr \u002F>\r\n\u003Cbr \u002F>\r\nFrom 1989-97, Schram worked as a purchasing assistant in the business office for Cal Athletics. Her first position at Cal was as a senior clerk in the Financial Services Office from 1985-89.\u003Cbr \u002F>\r\n\u003Cbr \u002F>\r\nSchram graduated from Cal State East Bay in 1985 with a Bachelor’s of Science in business administration.\u003Cbr \u002F>\r\n\u003Cbr \u002F>\r\nShe currently lives in Orinda with her husband, Jack, their children Griffin (24) & Maddy (19) and their dog, Kona.\u003Cbr \u002F>\r\n\u003Cbr \u002F>\r\nLast Updated\u003Cbr \u002F>\r\nMay 8, 2019\u003Cbr \u002F>\r\n\u003Cbr \u002F>\r\n \u003Cbr \u002F>\r\n ",{"staff_title":4316,"staff_email":7947,"staff_phone":-1,"staff_twitter":4326},"dschram@berkeley.edu",[9401,9402,9403,9404,9405,9406,9407,9408,9409,9410,9411],{"platformName":1020,"userName":15,"url":15,"icon":4364,"oldIcon":4365},{"platformName":1027,"userName":15,"url":15,"icon":4368,"oldIcon":4369},{"platformName":1014,"userName":15,"url":15,"icon":4372,"oldIcon":4373},{"platformName":4377,"userName":15,"url":15,"icon":4375,"oldIcon":4376},{"platformName":4381,"userName":15,"url":15,"icon":4379,"oldIcon":4380},{"platformName":4385,"userName":15,"url":15,"icon"