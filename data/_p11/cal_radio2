Name":15,"url":15,"icon":4372,"oldIcon":4373},{"platformName":4377,"userName":15,"url":15,"icon":4375,"oldIcon":4376},{"platformName":4381,"userName":15,"url":15,"icon":4379,"oldIcon":4380},{"platformName":4385,"userName":15,"url":15,"icon":4383,"oldIcon":4384},{"platformName":4389,"userName":15,"url":15,"icon":4387,"oldIcon":4388},{"platformName":4393,"userName":15,"url":15,"icon":4391,"oldIcon":4392},{"platformName":4397,"userName":15,"url":15,"icon":4395,"oldIcon":4396},{"platformName":4114,"userName":15,"url":15,"icon":4399,"oldIcon":4400},{"platformName":4404,"userName":15,"url":15,"icon":4402,"oldIcon":4403},{"id":8567,"title":8568,"firstName":8569,"lastName":8570,"image":8571,"sport":8575,"positionShort":-1,"call_to_action":-1,"bio":8576,"twitter":21,"images":15,"displayFields":8577,"latestBioId":8567,"email":21,"phone":21,"url":15,"staffId":8578,"socialMediaR":8579,"custom1":21,"custom2":21,"custom3":21,"custom4":21},6322,"Head Athletic Performance Coach - Football","Jason","Novak",{"altText":8572,"url":8573,"absoluteUrl":8574,"creditName":7943,"mediaCaption":15,"title":8572},"Jason Novak Head Shot","\u002Fimages\u002F2025\u002F2\u002F27\u002FJason_Novak_Cal____Headshots_25-0127_122916_Al_SermenoCROP_kMb8c.jpg","https:\u002F\u002Fcalbears.com\u002Fimages\u002F2025\u002F2\u002F27\u002FJason_Novak_Cal____Headshots_25-0127_122916_Al_SermenoCROP_kMb8c.jpg",{"id":210,"title":115,"shortDisplay":115,"shortName":209,"abbrev":206,"facebookPage":-1,"globalSportGender":171,"globalSportId":208,"globalSportShortName":-1,"globalSportNameSlug":209,"instagramName":-1,"nonSport":-1,"pinterestName":-1,"ticketsLink":15,"twitterName":-1,"youtubeName":-1,"rosterId":15,"scheduleId":15,"displayOpponentHistory":-1},"\u003Cp>\u003Cstrong>NFL Players Developed\u003C\u002Fstrong>\u003C\u002Fp>\r\n\r\n\u003Cp>\u003Cstrong>James Madison\u003C\u002Fstrong>\u003C\u002Fp>\r\n\r\n\u003Cul>\r\n\t\u003Cli>Zach Horton\u003C\u002Fli>\r\n\u003C\u002Ful>\r\n\r\n\u003Cp>\u003Cstrong>Michigan State\u003C\u002Fstrong>\u003C\u002Fp>\r\n\r\n\u003Cul>\r\n\t\u003Cli>AJ Arcuri\u003C\u002Fli>\r\n\t\u003Cli>Bryce Baringer\u003C\u002Fli>\r\n\t\u003Cli>Kendell Brooks\u003C\u002Fli>\r\n\t\u003Cli>Nathan Carter\u003C\u002Fli>\r\n\t\u003Cli>Keon Coleman\u003C\u002Fli>\r\n\t\u003Cli>Derrick Harmon\u003C\u002Fli>\r\n\t\u003Cli>Connor Heyward\u003C\u002Fli>\r\n\t\u003Cli>Trishton Jackson\u003C\u002Fli>\r\n\t\u003Cli>Naguan Jones\u003C\u002Fli>\r\n\t\u003Cli>Malik McDowell\u003C\u002Fli>\r\n\t\u003Cli>Jalen Nailor\u003C\u002Fli>\r\n\t\u003Cli>Jayden Reed\u003C\u002Fli>\r\n\t\u003Cli>Nick Samac\u003C\u002Fli>\r\n\t\u003Cli>Ameer Speed\u003C\u002Fli>\r\n\t\u003Cli>Ben VanSumeren\u003C\u002Fli>\r\n\t\u003Cli>Kenneth Walker III\u003C\u002Fli>\r\n\t\u003Cli>Cody White\u003C\u002Fli>\r\n\t\u003Cli>Kenny Willekes\u003C\u002Fli>\r\n\t\u003Cli>Jacoby Windmon\u003C\u002Fli>\r\n\u003C\u002Ful>\r\n\r\n\u003Cp>\u003Cstrong>Central Michigan\u003C\u002Fstrong>\u003C\u002Fp>\r\n\r\n\u003Cul>\r\n\t\u003Cli>Tyler Conklin\u003C\u002Fli>\r\n\t\u003Cli>Xavier Crawford\u003C\u002Fli>\r\n\t\u003Cli>Sean Murphy-Bunting\u003C\u002Fli>\r\n\t\u003Cli>Joe Ostman\u003C\u002Fli>\r\n\t\u003Cli>Cooper Rush\u003C\u002Fli>\r\n\u003C\u002Ful>\r\n\r\n\u003Cp>\u003Cstrong>Yale\u003C\u002Fstrong>\u003C\u002Fp>\r\n\r\n\u003Cul>\r\n\t\u003Cli>Nate Lawrie\u003C\u002Fli>\r\n\u003C\u002Ful>\r\n\r\n\u003Cp>\u003Cstrong>Alabama State\u003C\u002Fstrong>\u003C\u002Fp>\r\n\r\n\u003Cul>\r\n\t\u003Cli>Earl Cochran\u003C\u002Fli>\r\n\t\u003Cli>Johnny Huggins\u003C\u002Fli>\r\n\t\u003Cli>Tarvaris Jackson\u003C\u002Fli>\r\n\t\u003Cli>Chad Lucas\u003C\u002Fli>\r\n\t\u003Cli>Terrance Simmons\u003C\u002Fli>\r\n\u003C\u002Ful>\r\n\r\n\u003Cp dir=\"ltr\">\u003Cbr \u002F>\r\nTravers Family Head Football Coach Tosh Lupoi announced the return of Jason Novak as the team's head athletic performance coach on January 15, 2026.\u003C\u002Fp>\r\n\r\n\u003Cp dir=\"ltr\">Jason Novak returns to Cal for a second season as the head athletic performance coach in 2026 to continue a three-decade career that has given him extensive experience at the NFL, collegiate and elite prep levels. \u003C\u002Fp>\r\n\r\n\u003Cp dir=\"ltr\">Novak spent 11 campaigns on the strength and conditioning staff of the Tennessee Titans (2014-14) and has a combined 19 seasons of experience at the collegiate and elite prep levels (Alabama State, Baylor, California, Central Michigan, IMG Academy, James Madison, Michigan State, Stephen F. Austin, Yale). \u003C\u002Fp>\r\n\r\n\u003Cp dir=\"ltr\">Novak made an immediate impact in his first season at Cal in 2025, as the Bears got off to a strong 3-0 start and then had comeback wins against ranked teams in two of their final three regular-season contests at No. 15 Louisville in overtime and against No. 21 SMU. \u003C\u002Fp>\r\n\r\n\u003Cp dir=\"ltr\">Novak coached three Pro Football Hall of Famers and 29 Pro Bowlers with the Titans, while he has worked with 41 players during his collegiate and high school stops who have gone on to play in the NFL.\u003C\u002Fp>\r\n\r\n\u003Cp dir=\"ltr\">Novak earned a bachelor's degree in kinesiology from Stephen F. Austin in 1998 and his master's degree from Baylor in sport management in 2000.\u003C\u002Fp>\r\n\r\n\u003Cp dir=\"ltr\">A native of Houston, Texas, Novak and his wife, Michelle, have three children: Drew, Avery and Gray.\u003C\u002Fp>\r\n",{"staff_title":4316,"staff_email":7947,"staff_phone":7948,"staff_twitter":-1},5531,[8580,8581,8582,8583,8584,8585,8586,8587,8588,8589,8590],{"platformName":1020,"userName":15,"url":15,"icon":4364,"oldIcon":4365},{"platformName":1027,"userName":15,"url":15,"icon":4368,"oldIcon":4369},{"platformName":1014,"userName":15,"url":15,"icon":4372,"oldIcon":4373},{"platformName":4377,"userName":15,"url":15,"icon":4375,"oldIcon":4376},{"platformName":4381,"userName":15,"url":15,"icon":4379,"oldIcon":4380},{"platformName":4385,"userName":15,"url":15,"icon":4383,"oldIcon":4384},{"platformName":4389,"userName":15,"url":15,"icon":4387,"oldIcon":4388},{"platformName":4393,"userName":15,"url":15,"icon":4391,"oldIcon":4392},{"platformName":4397,"userName":15,"url":15,"icon":4395,"oldIcon":4396},{"platformName":4114,"userName":15,"url":15,"icon":4399,"oldIcon":4400},{"platformName":4404,"userName":15,"url":15,"icon":4402,"oldIcon":4403},{"id":8592,"title":8593,"firstName":8036,"lastName":8594,"image":8595,"sport":8600,"positionShort":-1,"call_to_action":-1,"bio":8601,"twitter":21,"images":15,"displayFields":8602,"latestBioId":8592,"email":8603,"phone":21,"url":15,"staffId":8604,"socialMediaR":8605,"custom1":21,"custom2":21,"custom3":21,"custom4":21},6356,"Quality Control, Special Teams","Werlinger",{"altText":8596,"url":8597,"absoluteUrl":8598,"creditName":8599,"mediaCaption":15,"title":8596},"Zach Werlinger Head Shot","\u002Fimages\u002F2021\u002F1\u002F23\u002FZach_Werlinger_FBC_20201017_150954_ADS_480x600.JPG","https:\u002F\u002Fcalbears.com\u002Fimages\u002F2021\u002F1\u002F23\u002FZach_Werlinger_FBC_20201017_150954_ADS_480x600.JPG","Al Sermeno - KLC fotos",{"id":210,"title":115,"shortDisplay":115,"shortName":209,"abbrev":206,"facebookPage":-1,"globalSportGender":171,"globalSportId":208,"globalSportShortName":-1,"globalSportNameSlug":209,"instagramName":-1,"nonSport":-1,"pinterestName":-1,"ticketsLink":15,"twitterName":-1,"youtubeName":-1,"rosterId":15,"scheduleId":15,"displayOpponentHistory":-1},"\u003Cstrong>Notable Players Coached\u003C\u002Fstrong>\r\n\r\n\u003Cul>\r\n\t\u003Cli>Connor Hulstein (Marist)\u003C\u002Fli>\r\n\t\u003Cli>EJ Warner (Rice)\u003C\u002Fli>\r\n\t\u003Cli>JT Daniels (Rice)\u003C\u002Fli>\r\n\t\u003Cli>Nikko Remigio (Cal)\u003C\u002Fli>\r\n\t\u003Cli>J. Michael Sturdivant (Cal)\u003C\u002Fli>\r\n\t\u003Cli>Jeremiah Hunter (Cal)\u003C\u002Fli>\r\n\t\u003Cli>Case Cookus (Northern Arizona) \u003C\u002Fli>\r\n\u003C\u002Ful>\r\nZach Werlinger returns to Berkeley for his second stint with the Golden Bears, this time as the quality control coach for special teams under head coach Tosh Lupoi.\u003Cbr \u002F>\r\n\u003Cbr \u002F>\r\nWerlinger rejoins the program following the 2025 season at Marist University, where he coached the tight ends and played a key role in the development of graduate transfer Connor Hulstein. Hulstein went on to become one of the most prolific tight ends in the FCS, earning AP Second Team All-American honors.\u003Cbr \u002F>\r\n\u003Cbr \u002F>\r\nPrior to Marist, Werlinger spent two seasons (2023–2024) at Rice University as an offensive quality control coordinator, working closely with the offensive coordinator and quarterbacks.\u003Cbr \u002F>\r\n\u003Cbr \u002F>\r\nWerlinger previously spent three seasons (2020-2022) at the University of California, Berkeley as an offensive graduate assistant, assisting with the wide receivers.\u003Cbr \u002F>\r\n\u003Cbr \u002F>\r\nIn 2019, Werlinger served as an offensive graduate assistant at Northern Arizona University, where he helped coach the quarterbacks, including 4,000-yard passer, Case Cookus.\u003Cbr \u002F>\r\n\u003Cbr \u002F>\r\nWerlinger began his coaching career in 2018 as the wide receivers coach at Worcester Polytechnic Institute (WPI), a Division III program in Worcester, Massachusetts.\u003Cbr \u002F>\r\n\u003Cbr \u002F>\r\nOriginally from Phoenix, Werlinger played quarterback at the University of Arizona, under Rich Rodriguez, from 2014 to 2017. He graduated with a degree in Communications from the University of Arizona and completed his Master’s degree in Public Health from UC Berkeley during his time as a graduate assistant. ",{"staff_title":4316,"staff_email":7947,"staff_phone":7948,"staff_twitter":-1},"zwerlinger@berkeley.edu",4064,[8606,8607,8608,8609,8610,8611,8612,8613,8614,8615,8616],{"platformName":1020,"userName":15,"url":15,"icon":4364,"oldIcon":4365},{"platformName":1027,"userName":15,"url":15,"icon":4368,"oldIcon":4369},{"platformName":1014,"userName":15,"url":15,"icon":4372,"oldIcon":4373},{"platformName":4377,"userName":15,"url":